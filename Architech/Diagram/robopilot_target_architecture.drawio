<mxfile host="app.diagrams.net">
  <diagram name="ROBOPILOT Target Architecture">
    <mxGraphModel dx="1900" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="ROBOPILOT Target Service Architecture - ECS Based" style="text;html=1;fontSize=26;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="430" y="20" width="850" height="40" as="geometry"/>
        </mxCell>

        <!-- Left side: clients/devices -->
        <mxCell id="clientBox" value="1. Clients &amp; Devices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontStyle=1;fontSize=16;align=center;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="310" height="360" as="geometry"/>
        </mxCell>

        <mxCell id="frontend" value="React Frontend&#xa;Vite + React + TypeScript" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="75" y="160" width="240" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="robot" value="GO2 Robot&#xa;Health / Telemetry / Job State" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="75" y="280" width="240" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="drone" value="DJI Drone&#xa;OSD / State / Services Reply" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="75" y="365" width="240" height="70" as="geometry"/>
        </mxCell>

        <!-- Public entry -->
        <mxCell id="alb" value="Application Load Balancer&#xa;Public API + WebSocket Entry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="490" y="130" width="300" height="90" as="geometry"/>
        </mxCell>

        <!-- ECS Cluster -->
        <mxCell id="ecsBox" value="2. ECS Cluster" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#558B2F;fontStyle=1;fontSize=17;align=center;verticalAlign=top;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="430" y="270" width="650" height="430" as="geometry"/>
        </mxCell>

        <mxCell id="api" value="cloud-api-service&#xa;Auth / CRUD / Dashboard / Stream / History&#xa;Public WebSocket Endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#558B2F;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="490" y="330" width="250" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="mqttService" value="mqtt-device-service&#xa;MQTT Consumers / Redis Runtime State&#xa;Device Events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#558B2F;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="780" y="330" width="250" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="notification" value="notification-service&#xa;Slack Reports / Retry Handling&#xa;Future Email / Alerts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#558B2F;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="490" y="530" width="250" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="queue" value="Notification Outbox / SQS&#xa;AI_REPORT_CREATED Event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#FBC02D;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="780" y="535" width="250" height="90" as="geometry"/>
        </mxCell>

        <!-- MQTT Broker -->
        <mxCell id="mqttBroker" value="MQTT Broker&#xa;EMQX / Managed MQTT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F3FF;strokeColor=#6A1B9A;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="490" y="760" width="250" height="90" as="geometry"/>
        </mxCell>

        <!-- Shared resources -->
        <mxCell id="sharedBox" value="3. Shared AWS Resources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00838F;fontStyle=1;fontSize=17;align=center;verticalAlign=top;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="1140" y="100" width="430" height="430" as="geometry"/>
        </mxCell>

        <mxCell id="rds" value="RDS PostgreSQL&#xa;Business Database" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFFFFF;strokeColor=#00838F;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1185" y="175" width="150" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="redis" value="Redis / ElastiCache&#xa;Device Runtime State" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFFFFF;strokeColor=#00838F;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1370" y="175" width="150" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="s3" value="Amazon S3&#xa;HLS / Metadata / Mission Files" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFFFFF;strokeColor=#00838F;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1185" y="310" width="150" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="cloudfront" value="CloudFront&#xa;Static / Playback Delivery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00838F;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1370" y="315" width="150" height="75" as="geometry"/>
        </mxCell>

        <mxCell id="secrets" value="Secrets Manager&#xa;DB / Slack / API Secrets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00838F;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1275" y="425" width="155" height="65" as="geometry"/>
        </mxCell>

        <!-- GPU AI -->
        <mxCell id="aiBox" value="4. GPU AI Infrastructure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontStyle=1;fontSize=17;align=center;verticalAlign=top;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="1140" y="590" width="430" height="260" as="geometry"/>
        </mxCell>

        <mxCell id="aiService" value="ai-service&#xa;AI Detection / DeepStream&#xa;info.json + bookmark.ndjson" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A1B9A;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1185" y="660" width="160" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="mediamtx" value="MediaMTX&#xa;RTMP / HLS Media Handling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A1B9A;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1390" y="660" width="150" height="100" as="geometry"/>
        </mxCell>

        <!-- External -->
        <mxCell id="slack" value="5. Slack&#xa;AI Detection Session Report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1220" y="900" width="300" height="90" as="geometry"/>
        </mxCell>

        <!-- Notes -->
        <mxCell id="note" value="Target State Summary&#xa;&#xa;• API, MQTT, Notification separated into ECS services&#xa;• GPU used only for AI workloads&#xa;• Redis owned by mqtt-device-service&#xa;• WebSocket exposed by cloud-api-service&#xa;• Slack handled asynchronously by notification-service&#xa;• Shared RDS initially, logical ownership first" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFDE7;strokeColor=#FBC02D;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="330" height="220" as="geometry"/>
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="Legend&#xa;&#xa;Blue: Public REST / WebSocket&#xa;Green: MQTT / Device Events&#xa;Black: Internal Service Flow&#xa;Purple: AI / Media Flow&#xa;Red: External Notification&#xa;Cyan: Shared AWS Resources" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontSize=13;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="330" height="190" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="edge_frontend_alb" value="HTTPS / WebSocket" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#1565C0;fontSize=12;" edge="1" parent="1" source="frontend" target="alb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge_alb_api" value="route API traffic" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#1565C0;fontSize=12;" edge="1" parent="1" source="alb" target="api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge_robot_broker" value="MQTT health / telemetry" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#2E7D32;fontSize=12;" edge="1" parent="1" source="robot" target="mqttBroker">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge_drone_broker" value="MQTT OSD / state" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#2E7D32;fontSize=12;" edge="1" parent="1" source="drone" target="mqttBroker">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge_broker_mqttsvc" value="device messages" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#2E7D32;fontSize=12;" edge="1" parent="1" source="mqttBroker" target="mqttService">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge_mqtt_redis" value="write online/status/telemetry" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#2E7D32;fontSize=12;" edge="1" parent="1" source="mqttService" target="redis">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge_mqtt_api" value="device status event" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#2E7D32;fontSize=12;" edge="1" parent="1" source="mqttService" target="api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge_api_redis" value="read runtime state" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#000000;fontSize=12;" edge="1" parent="1" source="api" target="redis">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge_api_rds" value="read/write business data" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#000000;fontSize=12;" edge="1" parent="1" source="api" target="rds">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge_api_s3" value="mission files / metadata" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#000000;fontSize=12;" edge="1" parent="1" source="api" target="s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge_s3_cf" value="serve playback/static" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#000000;fontSize=12;" edge="1" parent="1" source="s3" target="cloudfront">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge_api_ai" value="start/stop stream registration" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#6A1B9A;fontSize=12;" edge="1" parent="1" source="api" target="aiService">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge_ai_mediamtx" value="RTMP / HLS processing" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#6A1B9A;fontSize=12;" edge="1" parent="1" source="aiService" target="mediamtx">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge_ai_s3" value="HLS / info.json / bookmark.ndjson" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#6A1B9A;fontSize=12;" edge="1" parent="1" source="aiService" target="s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge_api_queue" value="AI_REPORT_CREATED" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#000000;fontSize=12;" edge="1" parent="1" source="api" target="queue">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge_queue_notification" value="consume event" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#000000;fontSize=12;" edge="1" parent="1" source="queue" target="notification">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge_notification_slack" value="send Slack report" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#C2185B;fontSize=12;" edge="1" parent="1" source="notification" target="slack">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge_secrets_api" value="inject secrets" style="endArrow=block;html=1;rounded=0;dashed=1;strokeWidth=2;strokeColor=#00838F;fontSize=12;" edge="1" parent="1" source="secrets" target="api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge_secrets_notification" value="Slack token" style="endArrow=block;html=1;rounded=0;dashed=1;strokeWidth=2;strokeColor=#00838F;fontSize=12;" edge="1" parent="1" source="secrets" target="notification">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
