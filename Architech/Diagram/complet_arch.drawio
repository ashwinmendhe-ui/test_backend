        <mxCell id="title" value="ROBOPILOT Diagram 3 - Runtime Service Interaction &amp; Event Flow" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=28;fontStyle=1;fontColor=#0B1020;" vertex="1" parent="1"><mxGeometry x="300" y="20" width="1200" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="How services interact in real-time and across the target separated architecture" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="1200" height="30" as="geometry"/></mxCell>

        <!-- Legend top -->
        <mxCell id="topLegend" value="Service Icons / Main Runtime Components" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="170" y="95" width="1460" height="55" as="geometry"/></mxCell>
        <mxCell id="lg1" value="cloud-api-service&lt;br&gt;(ECS Fargate)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="215" y="105" width="170" height="35" as="geometry"/></mxCell>
        <mxCell id="lg2" value="mqtt-device-service&lt;br&gt;(ECS Fargate)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00838F;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="405" y="105" width="180" height="35" as="geometry"/></mxCell>
        <mxCell id="lg3" value="notification-service&lt;br&gt;(ECS Fargate)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="605" y="105" width="180" height="35" as="geometry"/></mxCell>
        <mxCell id="lg4" value="ai-service&lt;br&gt;(GPU EC2 / ECS EC2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="805" y="105" width="190" height="35" as="geometry"/></mxCell>
        <mxCell id="lg5" value="Redis&lt;br&gt;(ElastiCache)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#D32F2F;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1015" y="105" width="150" height="35" as="geometry"/></mxCell>
        <mxCell id="lg6" value="RDS PostgreSQL&lt;br&gt;(Shared)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1185" y="105" width="170" height="35" as="geometry"/></mxCell>
        <mxCell id="lg7" value="S3 / CloudFront&lt;br&gt;(Storage + CDN)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#558B2F;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1375" y="105" width="200" height="35" as="geometry"/></mxCell>

        <!-- Devices -->
        <mxCell id="devicesBox" value="1. Devices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#2E7D32;fontStyle=1;fontSize=15;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="25" y="180" width="230" height="430" as="geometry"/></mxCell>
        <mxCell id="robot" value="&lt;b&gt;Robot (GO2)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Health&lt;br&gt;• Telemetry&lt;br&gt;• State / OSD&lt;br&gt;• Services Reply" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;fontSize=13;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="45" y="220" width="190" height="150" as="geometry"/></mxCell>
        <mxCell id="drone" value="&lt;b&gt;Drone (DJI)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• OSD / State&lt;br&gt;• Telemetry&lt;br&gt;• Services Reply" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;fontSize=13;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="45" y="410" width="190" height="150" as="geometry"/></mxCell>

        <!-- MQTT Service -->
        <mxCell id="mqttBox" value="2. mqtt-device-service&lt;br&gt;(ECS Fargate)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00838F;fontStyle=1;fontSize=15;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="360" y="180" width="250" height="330" as="geometry"/></mxCell>
        <mxCell id="mqttInner" value="• MQTT Subscriptions&lt;br&gt;• Robot Health / Telemetry&lt;br&gt;• DJI OSD / State&lt;br&gt;• Services Reply&lt;br&gt;• Redis Online/Offline State&lt;br&gt;• DeviceOfflineMonitor&lt;br&gt;• Device Event Generation&lt;br&gt;&lt;br&gt;&lt;b&gt;MQTT Client&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00838F;fontSize=13;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="375" y="235" width="220" height="245" as="geometry"/></mxCell>

        <!-- Redis -->
        <mxCell id="redis" value="&lt;b&gt;Redis (ElastiCache)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Device Online / Offline State&lt;br&gt;• Latest Telemetry&lt;br&gt;• Heartbeat&lt;br&gt;• Mission / Stream State" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#D32F2F;fontSize=13;align=left;spacingLeft=18;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="720" y="180" width="255" height="185" as="geometry"/></mxCell>

        <!-- Cloud API -->
        <mxCell id="cloudApi" value="5. cloud-api-service&lt;br&gt;(ECS Fargate)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontStyle=1;fontSize=15;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="690" y="410" width="300" height="310" as="geometry"/></mxCell>
        <mxCell id="cloudApiInner" value="• Auth&lt;br&gt;• Company / Site / User / Device CRUD&lt;br&gt;• Mission Management&lt;br&gt;• Stream Lifecycle (Start / Stop)&lt;br&gt;• Dashboard APIs&lt;br&gt;• History / Playback APIs&lt;br&gt;• Public WebSocket (/ws)&lt;br&gt;&lt;br&gt;&lt;b&gt;REST API + WebSocket&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;fontSize=13;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="710" y="465" width="260" height="230" as="geometry"/></mxCell>

        <!-- RDS -->
        <mxCell id="rds" value="&lt;b&gt;RDS PostgreSQL&lt;/b&gt;&lt;br&gt;(Shared)&lt;br&gt;&lt;br&gt;• Business Data&lt;br&gt;• ReportHistory&lt;br&gt;• Missions&lt;br&gt;• Users / Companies&lt;br&gt;• Devices&lt;br&gt;• notification_outbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=13;align=left;spacingLeft=18;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="360" y="545" width="250" height="250" as="geometry"/></mxCell>

        <!-- Clients -->
        <mxCell id="clients" value="4. Web / Mobile Clients&lt;br&gt;(Dashboard / Apps)&lt;br&gt;&lt;br&gt;• Dashboard&lt;br&gt;• Real-time Monitoring&lt;br&gt;• Mission / Device Mgmt&lt;br&gt;• History / Playback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=13;fontStyle=1;align=left;spacingLeft=18;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="500" y="840" width="280" height="180" as="geometry"/></mxCell>

        <!-- AI -->
        <mxCell id="ai" value="7. ai-service&lt;br&gt;(GPU EC2 / ECS EC2)&lt;br&gt;&lt;br&gt;• AI Detection (DeepStream)&lt;br&gt;• Object Detection&lt;br&gt;• HLS Generation&lt;br&gt;• info.json Generation&lt;br&gt;• bookmark.ndjson Generation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontSize=13;fontStyle=1;align=left;spacingLeft=18;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="1150" y="180" width="280" height="210" as="geometry"/></mxCell>

        <!-- Storage -->
        <mxCell id="s3" value="&lt;b&gt;S3 (Storage)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• HLS Segments&lt;br&gt;• info.json&lt;br&gt;• bookmark.ndjson&lt;br&gt;• Thumbnails&lt;br&gt;• Reports / Files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=13;align=left;spacingLeft=18;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="1210" y="470" width="235" height="205" as="geometry"/></mxCell>
        <mxCell id="cloudfront" value="&lt;b&gt;CloudFront (CDN)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• HLS Playback Delivery&lt;br&gt;• Global CDN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontSize=13;align=left;spacingLeft=18;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="1210" y="720" width="235" height="110" as="geometry"/></mxCell>
        <mxCell id="playback" value="10. Playback&lt;br&gt;(Web / Mobile)&lt;br&gt;&lt;br&gt;• Live Stream (HLS)&lt;br&gt;• History Playback&lt;br&gt;• Bookmarks&lt;br&gt;• Thumbnails&lt;br&gt;• Reports / Files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=13;fontStyle=1;align=left;spacingLeft=18;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="1540" y="620" width="225" height="220" as="geometry"/></mxCell>

        <!-- Notification -->
        <mxCell id="outbox" value="notification_outbox&lt;br&gt;(PostgreSQL)&lt;br&gt;&lt;br&gt;• Event Type&lt;br&gt;• Payload&lt;br&gt;• Status (PENDING)&lt;br&gt;• Retry Count&lt;br&gt;• Created At" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#5E97F6;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="960" y="755" width="170" height="160" as="geometry"/></mxCell>
        <mxCell id="notif" value="12. notification-service&lt;br&gt;(ECS Fargate)&lt;br&gt;&lt;br&gt;• Resolve Recipients&lt;br&gt;• Build Slack Message&lt;br&gt;• Retry Handling&lt;br&gt;• Future Email / Alerting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=13;fontStyle=1;align=left;spacingLeft=18;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="1260" y="860" width="255" height="185" as="geometry"/></mxCell>
        <mxCell id="slack" value="15. Slack&lt;br&gt;&lt;br&gt;AI Detection Session Report&lt;br&gt;to Company Users" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#D32F2F;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="1090" width="255" height="95" as="geometry"/></mxCell>

        <!-- Benefits -->
        <mxCell id="benefits" value="&lt;b&gt;Benefits&lt;/b&gt;&lt;br&gt;&lt;br&gt;✓ Service separation &amp; clear ownership&lt;br&gt;✓ Real-time device state via MQTT + Redis&lt;br&gt;✓ Scalable async notification&lt;br&gt;✓ Decoupled AI processing&lt;br&gt;✓ Reliable outbox pattern&lt;br&gt;✓ Cost optimized architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#2E7D32;fontSize=13;align=left;spacingLeft=18;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="1535" y="920" width="245" height="190" as="geometry"/></mxCell>

        <!-- Bottom key flows -->
        <mxCell id="keyflows" value="&lt;b&gt;Key Runtime Flows&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Devices publish telemetry via MQTT &amp;nbsp;&amp;nbsp; 2. mqtt-device-service updates Redis state &amp;nbsp;&amp;nbsp; 3. Device events go to cloud-api-service&lt;br&gt;4. cloud-api-service reads Redis for dashboard status &amp;nbsp;&amp;nbsp; 5. Web / Mobile clients use REST + WebSocket&lt;br&gt;6. Business data read/write to RDS &amp;nbsp;&amp;nbsp; 7. Start stream calls ai-service &amp;nbsp;&amp;nbsp; 8. Stream status returns to cloud-api-service&lt;br&gt;9. AI outputs are written to S3 and delivered by CloudFront &amp;nbsp;&amp;nbsp; 10. Users play live/history via HLS&lt;br&gt;11. stopStream creates ReportHistory &amp;nbsp;&amp;nbsp; 12. AI_REPORT_CREATED event added to outbox &amp;nbsp;&amp;nbsp; 13. notification-service polls outbox&lt;br&gt;14. Slack report sent asynchronously &amp;nbsp;&amp;nbsp; 15. Company users receive AI Detection Session Report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BDBDBD;dashed=1;fontSize=12;align=left;spacingLeft=18;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="300" y="1045" width="930" height="135" as="geometry"/></mxCell>

        <!-- Flow Legend -->
        <mxCell id="legend" value="&lt;b&gt;Legend (Flow Types)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Green: MQTT / Device Communication&lt;br&gt;Blue: HTTP / REST&lt;br&gt;Dark Blue: WebSocket / Real-time&lt;br&gt;Purple: AI / Stream Processing&lt;br&gt;Red: External Notification&lt;br&gt;Black Dashed: Internal Data / Control" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BDBDBD;dashed=1;fontSize=12;align=left;spacingLeft=18;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="25" y="880" width="250" height="210" as="geometry"/></mxCell>

        <!-- Edges -->
        <mxCell id="e1" value="1. MQTT Publish&lt;br&gt;health / telemetry&lt;br&gt;OSD / state" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D32;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="devicesBox" target="mqttBox"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="2. Update Device State" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#00838F;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;dashed=1;" edge="1" parent="1" source="mqttBox" target="redis"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="3. Publish Device Events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0D47A1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="mqttBox" target="cloudApi"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="4. Read Device State" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D32F2F;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;dashed=1;" edge="1" parent="1" source="cloudApi" target="redis"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5a" value="HTTPS / REST API&lt;br&gt;Request / Response" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1565C0;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="clients" target="cloudApi"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5b" value="WebSocket (/ws)&lt;br&gt;Real-time Updates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0D47A1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="cloudApi" target="clients"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="6. Read / Write&lt;br&gt;Business Data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1565C0;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="cloudApi" target="rds"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="7. Start Stream" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1A237E;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="cloudApi" target="ai"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="8. Stream Status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6A1B9A;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;dashed=1;" edge="1" parent="1" source="ai" target="cloudApi"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="9. Write Outputs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6A1B9A;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="ai" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6A1B9A;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="s3" target="cloudfront"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10b" value="10. HLS Playback" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6A1B9A;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;dashed=1;" edge="1" parent="1" source="cloudfront" target="playback"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="11. stopStream()&lt;br&gt;Create ReportHistory" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D32;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="cloudApi" target="outbox"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="12. Create&lt;br&gt;AI_REPORT_CREATED&lt;br&gt;Event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D32;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="rds" target="outbox"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="13. Poll / Read&lt;br&gt;PENDING Events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D32;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="outbox" target="notif"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="14. Send Slack&lt;br&gt;Report (Async)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D32F2F;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="notif" target="slack"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="15. User Acknowledges" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D32F2F;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;dashed=1;" edge="1" parent="1" source="slack" target="benefits"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="9. MQTT Commands&lt;br&gt;(if needed)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D32;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;dashed=1;" edge="1" parent="1" source="mqttBox" target="devicesBox"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
