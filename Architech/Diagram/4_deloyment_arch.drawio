        <mxCell id="ecs_cluster" value="&lt;b&gt;ECS Cluster - Fargate (Non-GPU Services)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#EEF6FF;strokeColor=#1E5BB8;fontSize=16;fontStyle=1;startSize=32;rounded=1;arcSize=6;dashed=1;dashPattern=8 4;" vertex="1" parent="vpc">
