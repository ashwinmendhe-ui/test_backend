        </mxCell>
        <mxCell id="api_ai" value="AI detection / stream request" style="endArrow=block;html=1;rounded=0;strokeColor=#6A1B9A;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="cloud_api" target="ai_service">
