          <mxGeometry x="25" y="60" width="190" height="245" as="geometry" />
        </mxCell>
        <mxCell id="mqtt_service" value="&lt;b&gt;mqtt-device-service&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;ECS Fargate Task&lt;/font&gt;&lt;br&gt;• MQTT subscriptions&lt;br&gt;• Robot health / telemetry&lt;br&gt;• DJI OSD / state&lt;br&gt;• DeviceOfflineMonitor&lt;br&gt;• Device events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00838F;fontSize=13;spacing=8;" vertex="1" parent="ecs_cluster">
