services:
  db:
    image: postgres:14
    container_name: robopilot-validation-db
    env_file: [./migration/db.env]
    volumes: [postgres:/var/lib/postgresql/data]
    restart: unless-stopped
    networks: [app]
  redis:
    image: redis:7-alpine
    container_name: robopilot-validation-redis
    volumes: [redis:/data]
    restart: unless-stopped
    networks: [app]
  mqtt:
    image: emqx/emqx:5.8.8
    container_name: robopilot-dev-mqtt-auth
    volumes:
      - ./migration/emqx.conf:/opt/emqx/etc/emqx.conf:ro
      - emqx:/opt/emqx/data
    ports: ["18883:1883"]
    restart: unless-stopped
    networks: [app]
  aws-auto:
    image: python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea
    container_name: robopilot-aws-auto
    user: "1000:1000"
    network_mode: host
    init: true
    restart: unless-stopped
    environment:
      HOME: /home/dhiveserver
      AWS_CONFIG_FILE: /home/dhiveserver/robopilot-local-20260911/aws-tools/robopilot-sso.config
      AWS_PAGER: ""
      PATH: /home/dhiveserver/robopilot-local-20260911/aws-tools/bin:/usr/local/bin:/usr/bin:/bin
    volumes:
      - /home/dhiveserver/robopilot-local-20260911/aws-tools:/home/dhiveserver/robopilot-local-20260911/aws-tools:ro
      - /home/dhiveserver/robopilot-local-20260911/aws-tools/auto-runtime:/home/dhiveserver/robopilot-local-20260911/aws-tools/auto-runtime:rw
    command: ["python", "/home/dhiveserver/robopilot-local-20260911/aws-tools/aws_connection_supervisor_20260911.py"]
    logging:
      driver: json-file
      options:
        max-size: "2m"
        max-file: "2"
  backend:
    image: robopilot-localenv-backend:20260917
    container_name: robopilot-dev-validation-backend
    env_file: [./migration/backend.env]
    environment:
      AWS_EC2_METADATA_DISABLED: "true"
      AWS_CONFIG_FILE: /run/robopilot-aws/config
      AWS_PROFILE: default
      APP_STORAGE_LOCAL_STREAM_DIR: /opt/robopilot/stream-archive
    volumes:
      - ./aws-tools/auto-runtime:/run/robopilot-aws:ro
      - ./data/stream-archive:/opt/robopilot/stream-archive:ro
    ports: ["127.0.0.1:6791:6789"]
    restart: unless-stopped
    networks: [app]
  web:
    image: nginx:stable-alpine
    container_name: robopilot-dev-web
    volumes:
      - ./external-web/html:/usr/share/nginx/html:ro
      - ./external-web/default.conf:/etc/nginx/conf.d/default.conf:ro
      - ./https-ip/letsencrypt:/etc/letsencrypt:ro
    ports: ["18080:80", "80:80", "443:443"]
    restart: unless-stopped
    networks: [app]
networks:
  app:
    name: robopilot-local
    ipam:
      config:
        - subnet: 172.18.0.0/16
          gateway: 172.18.0.1
volumes:
  postgres:
  redis:
  emqx:
