map $http_upgrade $connection_upgrade { default upgrade; '' close; }
server {
 listen 80;
 listen 443 ssl;
 ssl_certificate /etc/letsencrypt/live/112.219.173.114/fullchain.pem;
 ssl_certificate_key /etc/letsencrypt/live/112.219.173.114/privkey.pem;
 ssl_protocols TLSv1.2 TLSv1.3;
 server_name _;
 root /usr/share/nginx/html;
 index index.html;
 client_max_body_size 100m;
 location ^~ /.well-known/acme-challenge/ { default_type text/plain; try_files $uri =404; }
 location / { try_files $uri $uri/ /index.html; }
 location /archive/ { try_files $uri =404; autoindex off; }
 location /api/ {
  proxy_pass http://robopilot-dev-validation-backend:6789;
  proxy_set_header Host $http_host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_http_version 1.1;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;
  proxy_read_timeout 300s;
 }
 location /ws {
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_pass http://robopilot-dev-validation-backend:6789;
  proxy_set_header Host $http_host;
  proxy_http_version 1.1;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;
  proxy_read_timeout 300s;
 }
}
