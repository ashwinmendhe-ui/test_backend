# ROBOPILOT Backend Environment

# Public backend URL used for generating playback/proxy URLs
APP_PUBLIC_BASE_URL=http://localhost:6790

# AI service
AI_SERVICE_BASE_URL=http://<ai-service-host>:<ai-service-port>
AI_SERVICE_RTMP_URL=rtmp://43.202.9.216:1935

# Database
DB_HOST=<postgres-host>
DB_PORT=5432
DB_NAME=<db-name>
DB_USERNAME=<db-user>
DB_PASSWORD=<db-password>

# Redis
REDIS_HOST=<redis-host>
REDIS_PORT=6379

# MQTT / EMQX
MQTT_HOST=<mqtt-host>
MQTT_PORT=1883

# Slack
SLACK_ENABLED=false
SLACK_BOT_TOKEN=
MQTT_INBOUND_TOPIC=